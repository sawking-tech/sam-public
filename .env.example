# SAM (Smart Ambient Mate)
# Скопируй в .env и заполни значения. Не коммить .env в git!

# ===========================================
# AI APIs (ключи - только в .env, не в коде)
# ===========================================

# Claude Haiku - planning & structured tasks (лучший для TaskPlanner)
ANTHROPIC_API_KEY=

# Gemini Flash - primary LLM (бессрочный free tier, 1500 req/day)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Qwen DashScope - fallback LLM (1M токенов, 90 дней)
DASHSCOPE_API_KEY=

# GLM в облаке z.ai: выбрать поставщика - LLM_SOURCE=zai; модель и эндпоинт - по умолчанию из gateway/llm_router.py
ZAI_API_KEY=
# ZAI_MODEL=glm-5.3-flash
# ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Агрегаторы (LLM_SOURCE=openrouter или polza, либо LLM_FAST_SOURCE): ключ и id модели из каталога обязательны
OPENROUTER_API_KEY=
# Модель агента по метке сложности: SAM_AGENT_LLM_SMART|MEDIUM|WEAK=источник или источник:модель,
# например openrouter:z-ai/glm-5.3 (модель должна быть в <ИМЯ>_MODELS поставщика, если список задан)
# OPENROUTER_MODEL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
POLZA_API_KEY=
# POLZA_MODEL=
# POLZA_BASE_URL=https://polza.ai/api/v1

# Claude Code CLI использует Pro подписку - ключ не нужен
# ANTHROPIC_API_KEY не нужен

# ===========================================
# LM Studio (если включён)
# ===========================================
# LM Studio - используется если доступен и модель >= 7B
# Оставь пустым если не используешь
LMSTUDIO_URL=http://workpc:1234
# id модели из /v1/models (SAM-57); пусто - берётся единственная, при нескольких LM Studio пропускается
LMSTUDIO_MODEL=
# 1 - разбирать вызовы tools из текста ответа, 0 - только нативные tools (harmony и qwen разбираются всегда)
LLM_TEXT_TOOLS=1
# 1 - просить usage в стриме для счёта токенов (SAM-48); включать после проверки поставщика
LLM_STREAM_INCLUDE_USAGE=0
# Должно совпадать с "Max Concurrent Predictions" в LM Studio (default: 4)
LLM_CONCURRENCY=4
# Сроки ожидания поставщика в секундах (SAM-73); не дождались - поставщик в cooldown, ответ у запасного
LLM_CALL_TIMEOUT_S=120
LLM_FIRST_TOKEN_TIMEOUT_S=60
LLM_DELTA_TIMEOUT_S=30
# Голосовой ход /voice/turn (SAM-53): срок поиска в памяти до ответа, отсечка длины ответа
VOICE_RAG_TIMEOUT_S=1.5
VOICE_MAX_TOKENS=512

# ===========================================
# Сеть
# ===========================================
SAM_SERVER_HOST=192.168.1.100       # IP сервера в локальной сети
VPS_HOST=                            # IP VPS для FRP туннеля
VPS_USER=

# ===========================================
# MCP серверы на удалённых ПК
# ===========================================
WORKPC_MCP_URL=http://workpc:3000/sse
PC2_MCP_URL=http://pc2:3000/sse

# ===========================================
# Устройства (MAC для Wake on LAN)
# ===========================================
MY_PC_MAC=
PC2_MAC=
MY_PHONE_MAC=
PARTNER_PHONE_MAC=

# ===========================================
# Home Assistant
# ===========================================
HA_TOKEN=
HA_URL=http://localhost:8123

# ===========================================
# Базы данных
# ===========================================
MONGODB_URI=mongodb://localhost:27017
QDRANT_URL=http://localhost:6333

# ===========================================
# Speaker ID (pyannote.audio)
# ===========================================
PYANNOTE_TOKEN=
USER_1_NAME=
USER_2_NAME=

# ===========================================
# n8n
# ===========================================
N8N_USER=admin
N8N_PASSWORD=

# ===========================================
# Прочее
# ===========================================
WAKE_WORD=hey_sam
DEVICE_NAME=sam-satellite            # имя устройства в Wyoming

# Доступ к gateway и MCP-агрегатору (SAM-79): общий ключ; пусто - только с этой машины
SAM_API_KEY=
SAM_LOCAL_HOSTS=127.0.0.1,::1,localhost
# Без ключа - добавочные имена этой машины для заголовка Host (SAM-188, против DNS rebinding); свои адреса,
# имя машины, localhost и host.docker.internal пускаются и так
SAM_ALLOWED_HOSTS=
# Страницы, которым можно открыть WebSocket шлюза кроме своей (полный origin, через запятую)
SAM_ALLOWED_ORIGINS=

# Стабильность (SAM-80): воркеров одновременно; сколько раз тот же вызов с тем же результатом до остановки цикла
SAM_MAX_WORKERS=4
SAM_NO_PROGRESS_LIMIT=3

# Душа SAM - характер в Mongo `_soul` (gateway/soul_service.py). Заготовка для засева пустой базы: пусто -
# gateway/prompts/soul_seed.md. Инструкции SAM: пусто - SAM.md в корне. Личный слой: пусто - data/SAM.md.
# Относительный путь - от корня репозитория. Версий раздела для отката; без Mongo - повтор через столько секунд;
# сколько бриф ведущего ждёт Mongo
SAM_SOUL_SEED=
SAM_PROMPT_FILE=
SAM_PERSONAL_FILE=
SAM_SOUL_HISTORY=20
SAM_SOUL_RETRY_S=30
SAM_SOUL_DB_TIMEOUT_MS=1500
# Копия последней рабочей души для старта без Mongo: пусто - data/soul-cache.json
SAM_SOUL_COPY=
# Инструменты, после которых правка души в том же ходе запрещена (внешний текст); sandbox_* - всегда
SAM_EXTERNAL_TOOLS=search_web,mcp_call,fetch,claude_delegate

# Скиллы по запросу (SAM-61): папка со SKILL.md (пусто - проектная .claude/skills) и белый список имён через запятую
# (пусто - все)
SAM_SKILLS_DIR=
SAM_SKILLS_ALLOW=
# Личные скиллы Claude Code (~/.claude/skills), которые стенд отдаёт основным моделям; не задано - plan-and-iterate, пусто - никакие
# SAM_SKILLS_SHARED=plan-and-iterate
# Команды Claude Code в подсказке монитора по / (SAM-99): её личные скиллы, которыми она делится, через запятую
SAM_CLAUDE_CODE_COMMANDS=

# Агенты кода (SAM-60): разрешённые папки через ; (пусто - папка репозиториев, где лежит SAM), агент по умолчанию
# (claude | opencode | пусто - первый доступный), таймаут и его потолок, пути к CLI (пусто - поиск в PATH)
SAM_CODING_ROOTS=
SAM_CODING_AGENT=
SAM_CODING_TIMEOUT_S=300
SAM_CODING_MAX_TIMEOUT_S=1800
SAM_CLAUDE_CLI=
SAM_OPENCODE_CLI=
# Модели Claude Code: агент кода (Opus - только сложное программирование), служебные вызовы поставщика claude_code
# (Sonnet); пусто - модель по умолчанию самого CLI. Сессия-ведущий: "model" в .claude/settings.json
SAM_CLAUDE_CODING_MODEL=opus
SAM_CLAUDE_LEAD_MODEL=sonnet

# Фоновая работа с памятью в паузах (SAM-62, ADR-015): секунд тишины до сжатия; с такой историей - сразу
SAM_IDLE_S=30
SAM_COMPRESS_CEILING=28
# SAM-224: потолок сводок в контексте модели и сколько предшествующих сводок слияние пары получает фоном
SAM_COMPRESS_SUMMARY_CEILING=4
SAM_COMPRESS_MERGE_BACKGROUND=3
# SAM-227: окно канала мыслей (неозвученные блоки, вызовы) в токенах и потолок его сводок
SAM_COMPRESS_THOUGHT_KEEP_TOKENS=150
SAM_COMPRESS_THOUGHT_CEILING=2
# SAM-228: давнее из архива - реплик к фразе, окно развёртки записи-ссылки, пауза, после которой куски несмежные (с)
SAM_ARCHIVE_RAG_LIMIT=3
SAM_RECALL_WINDOW=20
SAM_RECALL_GAP_S=300
# предел ожидания поиска в архиве к фразе (с): не успел - ход без него
SAM_ARCHIVE_TIMEOUT_S=1.5
# Сырое окно и порог сжатия в токенах (SAM-62): окно, чанк за окном, символов на токен (замер 9 окт)
SAM_COMPRESS_KEEP_TOKENS=600
SAM_COMPRESS_CHUNK_TOKENS=250
SAM_CHARS_PER_TOKEN=3.3
# Автозапись фактов перед сжатием (SAM-63): 1 - включить; близость, с которой факт считается повтором
SAM_MEMORY_AUTOWRITE=0
SAM_MEMORY_DUP_SCORE=0.85
# Ночная консолидация памяти (SAM-22): 1 - включить; APPLY=1 - чистить мёртвые векторы индекса; окно часов и интервал
SAM_DREAM=0
SAM_DREAM_APPLY=0
SAM_DREAM_FROM_H=3
SAM_DREAM_TO_H=6
SAM_DREAM_INTERVAL_H=20

# Песочница (SAM-83, ADR-016): образ, сеть (none - без сети), лимиты, таймаут запуска и его потолок, папка задач
SAM_SANDBOX_IMAGE=sam-sandbox:2
SAM_SANDBOX_NETWORK=none
SAM_SANDBOX_MEMORY=512m
SAM_SANDBOX_CPUS=1
SAM_SANDBOX_PIDS=128
SAM_SANDBOX_TIMEOUT_S=60
SAM_SANDBOX_MAX_TIMEOUT_S=600
SAM_SANDBOX_DIR=
# Сколько ждёт второй запуск той же задачи, пока идёт первый; потолок файла задачи, который отдаёт показ
SAM_SANDBOX_JOB_WAIT_S=60
SAM_SANDBOX_SERVE_MAX_BYTES=20000000
# Копия с ПК в задачу (import): разрешённые папки через ; или , (пусто - выключено), потолки, свои маски пропуска
SAM_SANDBOX_IMPORT_ROOTS=
SAM_SANDBOX_IMPORT_MAX_FILES=2000
SAM_SANDBOX_IMPORT_MAX_BYTES=50000000
SAM_SANDBOX_IMPORT_SKIP=
# git clone в задачу (clone): хосты через ; или , (пусто - github.com, gitlab.com, codeberg.org, bitbucket.org;
# * - любой публичный по имени), таймаут клона, потолок размера клона в КБ
SAM_SANDBOX_CLONE_HOSTS=
SAM_SANDBOX_CLONE_TIMEOUT_S=120
SAM_SANDBOX_CLONE_MAX_KB=200000
# Выгрузка на ПК (export): папка экспорта (пусто - выключено; не корень диска, не домашняя, не папки SAM), потолки
SAM_SANDBOX_EXPORT_DIR=
SAM_SANDBOX_EXPORT_MAX_FILES=2000
SAM_SANDBOX_EXPORT_MAX_BYTES=100000000
# Пакеты песочницы (packages): таймаут установки, адрес и таймаут проверки OSV
SAM_SANDBOX_PKGS_TIMEOUT_S=300
SAM_SANDBOX_OSV_URL=https://api.osv.dev/v1/querybatch
SAM_SANDBOX_OSV_TIMEOUT_S=10
# Сеть песочницы по запросу (network=internet): своя сеть Docker и подсеть, образ стража правил DOCKER-USER
SAM_SANDBOX_NET=sam-sandbox-net
SAM_SANDBOX_SUBNET=10.232.0.0/24
SAM_SANDBOX_GUARD_IMAGE=sam-netguard:1
# Быстрая песочница (sandbox_exec, ADR-016): тёплый контейнер на сессию без сети - простой до остановки, потолок
# числа контейнеров, таймаут запуска и его потолок, потолок всего вызова основного агента (с замком и стартом),
# ожидание старта контейнера, период уборки простоя
SAM_FAST_SANDBOX_IDLE_S=600
SAM_FAST_SANDBOX_MAX=3
SAM_FAST_SANDBOX_TIMEOUT_S=30
SAM_FAST_SANDBOX_MAX_TIMEOUT_S=300
SAM_FAST_SANDBOX_MAIN_TIMEOUT_S=10
SAM_FAST_SANDBOX_START_S=60
SAM_FAST_SANDBOX_SWEEP_S=30
# Живые приложения SAM (SAM-182, docs/features/apps.md): папка и порты 127.0.0.1 под них
SAM_APPS_DIR=
# Приложение из задачи песочницы (from_job): потолки копии - число файлов и байты
SAM_APPS_EXPORT_MAX_FILES=20000
SAM_APPS_EXPORT_MAX_BYTES=300000000
SAM_APPS_PORT_BASE=18400
SAM_APPS_PORT_SPAN=200
SAM_APPS_SUBNET_BASE=10.231.0.0/16
SAM_APPS_PROXY_MAX_BYTES=20000000
SAM_APPS_PROXY_MAX_BODY=2000000

# Болталка (SAM-56): быстрая модель голоса и проверка её ответов основной
# Тишина по просьбе: фразы, после которых SAM молчит и не зовёт модель до обращения по имени
SAM_QUIET_PHRASES=помолчи,молчи,замолчи,замолкни,умолкни,не озвучивай,не отвечай,не встревай,не мешай,мы разговариваем,мы тут разговариваем,тишина
# Остановки: фраза только из них (можно с именем, «Сэм, стоп») - тоже просьба помолчать
SAM_STOP_WORDS=стоп,стой,хватит,тише
# SAM-88: секрет привилегированных голосовых команд (произносится во фразе); маскируется на входе и в истории
SAM_COMMAND_SECRET=
# SAM-104: другой ключ - SAM_<НАЗНАЧЕНИЕ>_SECRET (цифры); маскируется так же, привилегированные команды открывает только command
LLM_FAST_SOURCE=
LLM_FAST_MODEL=
# Основные модели по приоритету (SAM-91), через запятую, отвечает первая доступная.
# Значения: claude-code (сессия Claude Code, вкладку открывает start_sam только если она первая),
#           llm (модель шлюза из LLM_SOURCE), noop (молчит, отладка)
SAM_MAIN_MODELS=claude-code,llm
# ADR-027: проверка LM Studio (список и загруженность моделей) в кэше на столько секунд
SAM_LMSTUDIO_CACHE_S=5
# Слова, по которым фраза - секрет и быстрая видит её без содержания (через запятую; пусто - набор по умолчанию)
SAM_SECRET_TRIGGERS=
# SAM-226: рассуждение по роли (docs/features/llm-router.md, «Рассуждение»): SAM_REASONING_<РОЛЬ>=min|low, запас к пределу
# ответа, где рассуждение идёт, и поставщики, которым нужна инструкция отвечать сразу
SAM_REASONING_RESERVE_TOKENS=2048
SAM_REASONING_PROMPT_SOURCES=zai
# effort z.ai по уровню (low | high | max); пауза фонового сжатия сессии после сбоя
SAM_REASONING_ZAI_LOW=low
SAM_COMPRESS_FAIL_RETRY_S=120
# Сводки истории - на загруженной локальной qwen; off или недоступна - основная модель роутера
SAM_SERVICE_LLM_SOURCE=
SAM_SERVICE_LLM_MODEL=
# Проверку ответов быстрой ведут workflow fast-review и fast-action (SAM-166); поздняя поправка протухает через столько секунд
SAM_AMEND_TTL_S=20

# Лёгкие workflow стенда (SAM-96): 0 выключает планировщик; папка файлов, по умолчанию workflows/ в корне репозитория
SAM_WORKFLOWS=1
SAM_WORKFLOWS_DIR=
# Выключить отдельные workflow на этой машине, имена через запятую (late-night, memory-review)
SAM_WORKFLOWS_OFF=
SAM_WORKFLOW_TICK_S=30
SAM_WORKFLOW_GATE_TIMEOUT_S=10
# Ворота workflow «память»: насколько назад смотреть впервые и сколько символов услышанного отдать модели
SAM_MEMORY_REVIEW_LOOKBACK_S=3600
SAM_MEMORY_REVIEW_MAX_CHARS=4000

# Своя инициатива (SAM-49), ворота workflow late-night: поздний час и человек говорил за SAM_ACTIVE_S
SAM_LATE_FROM_H=2
SAM_LATE_TO_H=6
SAM_ACTIVE_S=600

# Компоненты стенда: скрытыми процессами с логом в logs/<компонент>.log; 1 - вкладками wt, как раньше
SAM_COMPONENT_TABS=
# Порог лога компонента, МБ: больше - при старте уходит в .1
SAM_COMPONENT_LOG_MAX_MB=20

# Сессия Claude Code - основная модель (SAM-91): start_sam.ps1 открывает её вкладкой, если lead.alive старше SAM_LEAD_ALIVE_S
SAM_LEAD_TERMINAL=wt
SAM_LEAD_COMMAND=claude
# Аргументы claude через пробел, например --model sonnet; пусто - модель из .claude/settings.json
SAM_LEAD_ARGS=
# Первое сообщение сессии; пусто - по умолчанию из scripts/sam_lead.ps1 (выполнить шаги старта из брифа хука)
SAM_LEAD_PROMPT=

# Радар присутствия по Wi-Fi (SAM-105): off (по умолчанию) - функция не включается, mock - демо на выдуманной планировке
SAM_PRESENCE=off
# Файл планировки квартиры (JSON: rooms, objects); пусто - демо-планировка
SAM_HOME_LAYOUT=
# Частота кадров источника, секунды; карта посещений и подписи зон лежат в data/
SAM_PRESENCE_TICK_S=0.2
SAM_PRESENCE_HEAT_FILE=data/presence_heat.json
SAM_PRESENCE_ZONES_FILE=data/presence_zones.json

# Записи слуха (SAM-106): сколько часов хранить mic-*.wav и phrases/*.wav и потолок всех записей вместе, МБ
SAM_MIC_KEEP_HOURS=24
SAM_MIC_KEEP_MB=600

# Имена домашних - только здесь, в коде их нет: профиль голоса -> имя, основы кличек питомцев, чья запись по умолчанию
# в оценке голосов и её псевдонимы, подпись человека в журнале, устройство этой машины в каталоге
SAM_SPEAKER_NAMES=
SAM_CAT_NAMES=
SAM_EVAL_DEFAULT_PERSON=
SAM_EVAL_ALIASES=
SAM_LOCAL_DEVICE=workpc
# Шаг ask workflow: потолок ответа основной модели (у GLM рассуждение входит в выход)
SAM_WORKFLOW_ASK_MAX_TOKENS=1024
# Заметки основной модели о разговоре (SAM-131): старше - не идут быстрой; сколько реплик видит шаг обновления
SAM_DIALOGUE_NOTES_MAX_AGE_S=3600
SAM_DIALOGUE_NOTES_TURNS=30
# Граница компетенции быстрой (SAM-169): на факт вне разговора быстрая берёт паузу, отвечает основная; 0 - выключить
SAM_FAST_BOUNDARY=1
# Паузы быстрой до ответа основной через |; дополнительные глаголы действия
SAM_FAST_PAUSE_PHRASES=Сейчас посмотрю.|Дай подумать.|Сейчас гляну.|Секунду, посмотрю, что могу сделать.|Сейчас вспомню.|Не уверена, сейчас проверю.
SAM_ACTION_VERBS_EXTRA=
# Откат быстрого голоса по поправкам (SAM-168): окно счёта, первый срок, множитель, потолок - секунды
SAM_FAST_BACKOFF_WINDOW_S=300
SAM_FAST_BACKOFF_BASE_S=60
SAM_FAST_BACKOFF_FACTOR=2
SAM_FAST_BACKOFF_MAX_S=1800
# Эмбеддер отдельным процессом (SAM-172): адрес для шлюза (пусто - модель в процессе шлюза) и порт процесса
SAM_EMBEDDER_URL=http://127.0.0.1:10204
SAM_EMBEDDER_PORT=10204
# Поправка посреди реплики быстрой (SAM-167): звучащее затихает до паузы между словами - секунды и громкость
SAM_FIX_KEEP_SECS=0.6
SAM_FIX_FADE_SECS=0.3
SAM_FIX_LEVEL=0.3
# Канал агента разработки к создателю (SAM-164): сколько ждать ответа на вопрос, как часто смотреть входящие, сколько реплик за раз
SAM_AGENT_ASK_WAIT_S=120
SAM_AGENT_POLL_S=2
SAM_AGENT_INBOX_MAX=20
# Быстрый голос при ведущем Claude Code (SAM-173): быстрая отвечает сразу, ведущий следом; 0 - ведущий отвечает один
SAM_FAST_WITH_LEAD=1
