{
    "device": "pc",
    "description": "Серверы MCP этой машины. Windows-управление - windows.example.json",
    "mcp_port": 3000,
    "servers": [
        {
            "name": "skills",
            "command": "python",
            "args": [
                "mcp/skills_server.py"
            ],
            "description": "Скиллы стенда для моделей вне шлюза (ADR-022)"
        },
        {
            "name": "radar",
            "command": "python",
            "args": [
                "mcp/radar_server.py"
            ],
            "description": "Радар присутствия: где кто сейчас, где был, разметка, запись со слов. Поднимается только при SAM_RADAR=1"
        },
        {
            "name": "fetch",
            "command": "uvx",
            "args": [
                "mcp-server-fetch"
            ],
            "description": "URL в markdown"
        },
        {
            "name": "time",
            "command": "uvx",
            "args": [
                "mcp-server-time"
            ],
            "description": "Текущее время и часовые пояса"
        }
    ]
}
