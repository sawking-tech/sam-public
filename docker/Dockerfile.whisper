FROM rhasspy/wyoming-whisper:latest

# Install CUDA 12 runtime libs via pip (bundled with nvidia packages)
RUN /usr/src/.venv/bin/pip install --no-cache-dir \
    nvidia-cublas-cu12 \
    nvidia-cudnn-cu12

# Make libs discoverable by ctranslate2
ENV LD_LIBRARY_PATH=/usr/src/.venv/lib/python3.11/site-packages/nvidia/cublas/lib:/usr/src/.venv/lib/python3.11/site-packages/nvidia/cudnn/lib:${LD_LIBRARY_PATH}
